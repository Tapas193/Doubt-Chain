// Prisma schema for Doubt-Chain
// Designed from PRD: User, Subject, Doubt, Answer, upvote representation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Profession {
  STUDENT
  PROFESSOR
  CORPORATE_WORKER
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  username              String     @unique
  displayName           String
  fullName              String?
  profession            Profession?
  identificationNumber  String?
  passwordHash          String
  preferredLanguage     String?    @default("en")
  role                  String?    @default("STUDENT")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  doubts   Doubt[]
  answers  Answer[]
  upvotes  AnswerUpvote[]
  comments AnswerComment[]
  subjectMemberships SubjectMember[]
  attachments Attachment[]
  searchFeedbacks SearchFeedback[]
  aiConversations AiAssistantConversation[]
  aiFeedbacks     AiResponseFeedback[]
  aiReports       AiResponseReport[]
  createdCommunities Community[] @relation("CommunityCreator")
  communityMemberships CommunityMember[]
  reviewedMemberships CommunityMember[] @relation("ReviewedMemberships")
  communityAnnouncements CommunityAnnouncement[]
  sharedDoubts Doubt[] @relation("DoubtSharedBy")
  notifications Notification[]
  discussionReports DiscussionReport[]
  resolvedReports DiscussionReport[] @relation("ReportResolver")

  @@index([profession])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  joinCode    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doubts        Doubt[]
  members       SubjectMember[]
  topicClusters TopicCluster[]
}

model SubjectMember {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
  @@index([userId])
}

model Doubt {
  id          String   @id @default(cuid())
  title       String
  content     String
  mediaUrl    String?
  mediaType   MediaType?
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  answers          Answer[] @relation("DoubtAnswers")
  acceptedAnswerId String?   @unique
  acceptedAnswer   Answer?   @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  embedding   DoubtEmbedding?
  topicAssignment DoubtTopicAssignment?
  feedbacks   SearchFeedback[]

  aiQuestion    String?
  aiAnswer      String?
  aiTags        String[]          @default([])
  aiGeneratedAt DateTime?
  aiStatus      ProcessingStatus  @default(COMPLETED)

  communityId                String?
  community                  Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  isSharedWithWiderNetwork   Boolean            @default(false)
  sharedAt                   DateTime?
  sharedById                 String?
  sharedBy                   User?              @relation("DoubtSharedBy", fields: [sharedById], references: [id], onDelete: SetNull)
  academicCategory           String?            @default("GENERAL_DOUBT")
  reports                    DiscussionReport[]

  @@index([subjectId, isResolved, createdAt])
  @@index([authorId])
  @@index([communityId, isSharedWithWiderNetwork])
}

model Answer {
  id        String   @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType MediaType?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  doubtId     String
  doubt       Doubt  @relation("DoubtAnswers", fields: [doubtId], references: [id], onDelete: Cascade)
  acceptedBy  Doubt? @relation("AcceptedAnswer")

  parentAnswerId String?
  parentAnswer   Answer?  @relation("AnswerReplies", fields: [parentAnswerId], references: [id], onDelete: Cascade)
  replies        Answer[] @relation("AnswerReplies")

  upvotes     AnswerUpvote[]
  comments    AnswerComment[]
  attachments Attachment[]
  reports     DiscussionReport[]

  @@index([doubtId, createdAt])
  @@index([authorId])
  @@index([parentAnswerId])
}

model AnswerUpvote {
  id        String   @id @default(cuid())
  value     Int      @default(1)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
  @@index([answerId])
}

model AnswerComment {
  id        String   @id @default(cuid())
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId, createdAt])
  @@index([authorId])
}

model Attachment {
  id               String           @id @default(cuid())
  url              String
  filename         String
  fileType         MediaType
  mimeType         String
  size             Int
  extractedText    String?
  detectedLanguage String?
  processingStatus ProcessingStatus @default(COMPLETED)
  processingError  String?
  createdAt        DateTime         @default(now())

  doubtId    String?
  doubt      Doubt?    @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([doubtId])
  @@index([answerId])
  @@index([uploaderId])
}

model DoubtEmbedding {
  id          String   @id @default(cuid())
  doubtId     String   @unique
  doubt       Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  contentHash String
  vector      Float[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doubtId])
}

model SearchFeedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubtId   String?
  doubt     Doubt?         @relation(fields: [doubtId], references: [id], onDelete: SetNull)
  action    FeedbackAction
  query     String
  createdAt DateTime       @default(now())

  @@unique([userId, doubtId, action, query])
  @@index([userId])
  @@index([doubtId])
}

model ContentTranslation {
  id             String   @id @default(cuid())
  sourceHash     String
  targetLang     String
  sourceLang     String?
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([sourceHash, targetLang])
  @@index([sourceHash])
}

enum MediaType {
  IMAGE
  AUDIO
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FeedbackAction {
  ANSWERED_MY_DOUBT
  NONE_HELPED_POSTED
}

model AiAssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subjectId String?
  language  String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  AiAssistantMessage[]

  @@index([userId, updatedAt])
}

model AiAssistantMessage {
  id               String   @id @default(cuid())
  conversationId   String
  conversation     AiAssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String   // "user" | "assistant"
  content          String
  retrievedContext Json?
  createdAt        DateTime @default(now())

  feedback         AiResponseFeedback?
  reports          AiResponseReport[]

  @@index([conversationId, createdAt])
}

model AiResponseFeedback {
  id        String   @id @default(cuid())
  messageId String   @unique
  message   AiAssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId])
}

model AiResponseReport {
  id        String   @id @default(cuid())
  messageId String
  message   AiAssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   // FACTUALLY_INCORRECT, INCORRECT_CODE, MISLEADING_EXPLANATION, TRANSLATION_ISSUE, OTHER
  details   String?
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
}

model TopicCluster {
  id          String   @id @default(cuid())
  name        String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  vector      Float[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments DoubtTopicAssignment[]

  @@index([subjectId])
  @@index([name])
}

model DoubtTopicAssignment {
  id         String       @id @default(cuid())
  doubtId    String       @unique
  doubt      Doubt        @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  topicId    String
  topic      TopicCluster @relation(fields: [topicId], references: [id], onDelete: Cascade)
  similarity Float        @default(1.0)
  createdAt  DateTime     @default(now())

  @@index([topicId])
  @@index([doubtId])
}

model Community {
  id           String            @id @default(cuid())
  name         String            @unique
  code         String            @unique
  slug         String            @unique
  description  String?
  logoUrl      String?
  emailDomain  String?
  department   String?
  academicYear String?
  location     String?
  isVerified   Boolean           @default(true)
  status       CommunityStatus   @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  creatorId    String?
  creator      User?             @relation("CommunityCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  members       CommunityMember[]
  doubts        Doubt[]
  announcements CommunityAnnouncement[]

  @@index([code])
  @@index([slug])
}

enum CommunityStatus {
  ACTIVE
  SUSPENDED
}

model CommunityMember {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId     String
  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  role            CommunityRole    @default(STUDENT)
  status          MembershipStatus @default(PENDING)
  isPrimary       Boolean          @default(false)
  department      String?
  academicYear    String?
  requestedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?            @relation("ReviewedMemberships", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, communityId])
  @@index([communityId, status])
  @@index([userId, isPrimary])
}

enum CommunityRole {
  STUDENT
  MODERATOR
  COLLEGE_ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model CommunityAnnouncement {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  priority    String    @default("NORMAL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  NEW_REPLY
  WIDER_NETWORK_REPLY
  WIDER_NETWORK_SHARED
  CONTENT_MODERATED
}

model DiscussionReport {
  id           String       @id @default(cuid())
  doubtId      String?
  doubt        Doubt?       @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  answerId     String?
  answer       Answer?      @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       ReportStatus @default(PENDING)
  resolvedById String?
  resolvedBy   User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([doubtId])
  @@index([answerId])
  @@index([status])
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}
