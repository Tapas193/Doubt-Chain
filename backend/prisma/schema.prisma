// Prisma schema for Doubt-Chain
// Designed from PRD: User, Subject, Doubt, Answer, upvote representation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Profession {
  STUDENT
  PROFESSOR
  CORPORATE_WORKER
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  username              String     @unique
  displayName           String
  fullName              String?
  profession            Profession?
  identificationNumber  String?
  passwordHash          String
  preferredLanguage     String?    @default("en")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  doubts   Doubt[]
  answers  Answer[]
  upvotes  AnswerUpvote[]
  comments AnswerComment[]
  subjectMemberships SubjectMember[]
  attachments Attachment[]
  searchFeedbacks SearchFeedback[]

  @@index([profession])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  joinCode    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doubts  Doubt[]
  members SubjectMember[]
}

model SubjectMember {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
  @@index([userId])
}

model Doubt {
  id          String   @id @default(cuid())
  title       String
  content     String
  mediaUrl    String?
  mediaType   MediaType?
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  answers          Answer[] @relation("DoubtAnswers")
  acceptedAnswerId String?   @unique
  acceptedAnswer   Answer?   @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  embedding   DoubtEmbedding?
  feedbacks   SearchFeedback[]

  aiQuestion    String?
  aiAnswer      String?
  aiTags        String[]          @default([])
  aiGeneratedAt DateTime?
  aiStatus      ProcessingStatus  @default(COMPLETED)

  @@index([subjectId, isResolved, createdAt])
  @@index([authorId])
}

model Answer {
  id        String   @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType MediaType?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  doubtId     String
  doubt       Doubt  @relation("DoubtAnswers", fields: [doubtId], references: [id], onDelete: Cascade)
  acceptedBy  Doubt? @relation("AcceptedAnswer")

  parentAnswerId String?
  parentAnswer   Answer?  @relation("AnswerReplies", fields: [parentAnswerId], references: [id], onDelete: Cascade)
  replies        Answer[] @relation("AnswerReplies")

  upvotes     AnswerUpvote[]
  comments    AnswerComment[]
  attachments Attachment[]

  @@index([doubtId, createdAt])
  @@index([authorId])
  @@index([parentAnswerId])
}

model AnswerUpvote {
  id        String   @id @default(cuid())
  value     Int      @default(1)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
  @@index([answerId])
}

model AnswerComment {
  id        String   @id @default(cuid())
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId, createdAt])
  @@index([authorId])
}

model Attachment {
  id               String           @id @default(cuid())
  url              String
  filename         String
  fileType         MediaType
  mimeType         String
  size             Int
  extractedText    String?
  detectedLanguage String?
  processingStatus ProcessingStatus @default(COMPLETED)
  processingError  String?
  createdAt        DateTime         @default(now())

  doubtId    String?
  doubt      Doubt?    @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([doubtId])
  @@index([answerId])
  @@index([uploaderId])
}

model DoubtEmbedding {
  id          String   @id @default(cuid())
  doubtId     String   @unique
  doubt       Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  contentHash String
  vector      Float[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doubtId])
}

model SearchFeedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubtId   String?
  doubt     Doubt?         @relation(fields: [doubtId], references: [id], onDelete: SetNull)
  action    FeedbackAction
  query     String
  createdAt DateTime       @default(now())

  @@unique([userId, doubtId, action, query])
  @@index([userId])
  @@index([doubtId])
}

model ContentTranslation {
  id             String   @id @default(cuid())
  sourceHash     String
  targetLang     String
  sourceLang     String?
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([sourceHash, targetLang])
  @@index([sourceHash])
}

enum MediaType {
  IMAGE
  AUDIO
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FeedbackAction {
  ANSWERED_MY_DOUBT
  NONE_HELPED_POSTED
}


